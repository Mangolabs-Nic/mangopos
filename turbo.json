{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**"],
      "inputs": ["src/**"]
    },
    "@mangolabs/pos-api#build": {
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.build.json", "nest-cli.json"]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
