{
  "name": "mangopos",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "supabase start && docker compose up -d --build",
    "dev:logs": "docker compose logs -f api",
    "dev:down": "docker compose down",
    "api:dev": "npm run start:dev --workspace=@mangolabs/mangopos-api",
    "api:build": "turbo run build --filter=@mangolabs/mangopos-api",
    "api:start": "npm run start:prod --workspace=@mangolabs/mangopos-api",
    "api:test": "npm run test --workspace=@mangolabs/mangopos-api",
    "db:verify": "docker exec -i supabase_db_mangopos psql -U postgres -d postgres < scripts/verify-schema.sql",
    "docs:start": "turbo run start --filter=@mangolabs/mangopos-docs",
    "docs:build": "turbo run build --filter=@mangolabs/mangopos-docs",
    "turbo:graph": "turbo run build --graph"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
