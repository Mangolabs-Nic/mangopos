# Copy to .env and fill from `supabase status` (local) or Railway variables (staging).
# Never commit the real .env.

# Postgres connection string
DATABASE_URL=

# Supabase project URL
SUPABASE_URL=

# Public anon key. Safe to ship in the browser bundle.
SUPABASE_ANON_KEY=

# Service role key. BYPASSES row-level security. Server-side only, never expose to a client.
SUPABASE_SERVICE_KEY=

# development | production
NODE_ENV=development

# API port. Railway assigns this in deployed environments.
PORT=4000
