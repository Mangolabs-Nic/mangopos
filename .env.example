# Copy to .env and fill from `supabase status` (local) or Railway variables (staging).
# Never commit the real .env.

# Postgres connection string
DATABASE_URL=

# Supabase project URL
SUPABASE_URL=

# Public anon key. Safe to ship in the browser bundle.
SUPABASE_ANON_KEY=

# Service role key. BYPASSES row-level security. Server-side only, never expose to a client.
# Also used to append API-origin audit entries through the audit_append RPC.
SUPABASE_SERVICE_KEY=

# HMAC pepper for the employee PIN blind index. 16+ characters, generated once and
# never changed afterwards: changing it invalidates every stored PIN.
#   openssl rand -hex 32
PIN_PEPPER=

# Legacy JWT secret (HS256). Not used when SUPABASE_URL is set: the API verifies
# with the project JWKS, because a current Supabase project signs with ES256.
SUPABASE_JWT_SECRET=

# development | production
NODE_ENV=development

# API port. Railway assigns this in deployed environments.
PORT=4000
